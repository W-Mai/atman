flow agent(user_prompt: string) -> string {
    contract {
        capabilities { shell: true }
        invocation { user_message: user_prompt, goal: true }
    }
    return agent_loop("direct").await
}

flow agent_loop(completion_state: string) -> string {
    reply = llm.call(
        model: "smart",
        effort: env("effort"),
        context: "session",
        system: "Create a goal for actionable requests with memory.goal.set. Active goals continue across turns; pause with memory.goal.pause after completion or when input is required, then give the final response. Read goal.get before updates. Planning tools: use plan.write/read/tick for the active high-level route through a multi-step task. A plan is a durable ordered checklist that atman injects back into every LLM call; create or revise one for work that spans several steps, files, tool calls, or turns, then call plan.tick when a plan step is truly complete. Use memory.todo.set/done/cancel/delete/list for concrete execution items inside the current plan step: small trackable units with where/why/how/expected_result, especially when you need a visible work queue or may pause and resume. Do not mirror the same item in both systems. If a plan step is enough, do not create a todo. If a todo becomes the whole strategy, replace it with a plan. Typical flow: set or read the plan, execute one plan step, create todos only for that step's sub-work, finish/cancel those todos, then tick the plan step. You MUST end every turn through final.answer, including simple questions, clarification requests, blocked work, and sub-agent reports, even without other tool work or a goal. Never end with ordinary assistant text. Emit exactly one final.answer call with no sibling calls or accompanying text; put the complete response in message and a concise response summary in _atman_intent. If a goal must be paused, call memory.goal.pause first, wait for its result, then call final.answer separately.",
        cache: true,
        retry: 12,
        tools: [
            "fs.read", "image.read", "fs.write", "fs.edit", "fs.list", "fs.grep",
            "bash.spawn", "bash.status", "bash.output", "bash.kill", "bash.list",
            "term.spawn", "term.input", "term.capture", "term.resize", "term.kill", "term.list",
            "web.fetch", "web.search",
            "hunk.review", "hunk.apply", "hunk.plan_edit",
            "git.diff", "git.show", "git.log", "git.status", "git.add", "git.commit", "git.branch", "git.push", "test.run",
            "memory.confess", "memory.fetch_confessions",
            "memory.todo.set", "memory.todo.done", "memory.todo.cancel", "memory.todo.delete", "memory.todo.list",
            "memory.goal.get", "memory.goal.set", "memory.goal.pause", "memory.goal.resume",
            "memory.recent_turns", "memory.history.search", "memory.history.read",
            "memory.spec.status", "memory.spec.update", "memory.spec.deviate", "memory.spec.materialize",
            "plan.write", "plan.read", "plan.tick",
            "permission.list", "permission.get", "permission.group", "permission.ungroup",
            "permission.approve", "permission.deny", "permission.defer", "permission.batch",
            "agent.spawn",
            "form.ask",
            "final.answer",
            "preview.push",
            "session.push", "sleep", "message.user",
            "mcp.status", "mcp.tools", "mcp.await", "mcp.call"
        ],
    )
    final_answer = extract_final_answer(reply)
    tool_uses = extract_tool_uses(reply)
    final_answer_attempt = list.any(tool_uses, |call| call.name == "final.answer")
    when is_empty(tool_uses) {
        candidate = text_concat(reply)
        when final_answer {
            candidate = final_answer
        }
        when final_answer {
            session.push(finalize_response(reply))
            return final_answer
        }
        when completion_state == "worked" {
            session.push(message.user("Agent loop control: your next response MUST include exactly one final.answer tool call and no other tool calls. Put the complete user-facing Markdown in message and include a concise _atman_intent for the work header. Any accompanying assistant text does not replace message."))
            return agent_loop("reminded").await
        }
        return candidate
    }
    tool_results = dispatch_all(tool_uses)
    session.push(tool_results)
    completion_state = "worked"
    when final_answer_attempt {
        completion_state = "reminded"
    }
    return agent_loop(completion_state).await
}
