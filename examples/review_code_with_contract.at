flow review_code(file: path) -> Review {
    contract {
        scope {
            read: [project_root]
            write: []
        }
        interjection {
            accept: [L1, L4]
        }
    }

    gather = fanout [
        fs.read(file),
        rule.fetch("code-review"),
    ] collect: all

    primary = llm.call(
        model: "smart",
        prompt: @"prompts/code-review.md",
        input: gather,
    )

    return primary
}
