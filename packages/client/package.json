{
  "name": "@atman/client",
  "version": "1.10.0",
  "description": "Typed browser and JavaScript client for the atman daemon",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "generate": "bun run scripts/generate.ts",
    "check:generated": "bun run scripts/generate.ts --check",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "quality": "bun run check:generated && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "^7.0.2"
  }
}
