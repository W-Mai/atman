{
  "name": "@atman/client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "bun test",
    "generate": "bun tools/generate.ts",
    "build:web": "bun web/build.ts",
    "quality": "bun run check && bun run check:web && bun --filter @atman/mobile check && bun run test",
    "check:web": "bun --filter @atman/web check",
    "dev:web": "bun --filter @atman/web dev"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  },
  "workspaces": [
    "web",
    "mobile"
  ]
}
